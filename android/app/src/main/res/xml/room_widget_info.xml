<?xml version="1.0" encoding="utf-8"?>
<!-- Raum-Widget. Aktualisiert wird über WorkManager (alle 15 Minuten), nach
     dem Schalten und wenn die App eine Änderung meldet. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="de.phiph.haven.widget.RoomWidgetConfigActivity"
    android:description="@string/room_widget_description"
    android:initialLayout="@layout/room_widget"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/room_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
